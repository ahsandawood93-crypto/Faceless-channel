# ============================================================
# Kids Edu YT — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real keys.
# NEVER commit .env to git. It is listed in .gitignore.
#
# Keys here are for CONTENT CREATION ONLY.
# No auto-upload, auto-publish, or payment keys are stored here.
# YouTube upload is a manual step requiring explicit human approval.
# ============================================================

# --- AI (Script / Research / Planning) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here          # optional fallback

# --- Search & Trend Research ---
SERPER_API_KEY=your_serper_api_key_here          # serper.dev — Google search results
YOUTUBE_DATA_API_KEY=your_youtube_data_api_key_here  # read-only, for trend research only

# --- Text-to-Speech ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here  # or your preferred TTS provider
# GOOGLE_TTS_API_KEY=                            # alternative
# AZURE_TTS_KEY=                                 # alternative

# --- Image / Visual Generation (optional) ---
# STABILITY_API_KEY=                             # Stability AI / SDXL
# RUNWAYML_API_KEY=                              # RunwayML / Gen-3 (Veo-compatible workflow)
# IDEOGRAM_API_KEY=                              # Ideogram for text-on-image thumbnails

# ============================================================
# DO NOT ADD:
#   - YouTube OAuth tokens (upload triggers manual step only)
#   - Payment / billing keys
#   - Channel settings credentials
# ============================================================
