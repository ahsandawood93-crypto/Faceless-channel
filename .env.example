# Minsa Kids TV Autopilot — secrets and API settings.
# Copy to .env and fill in. .env is git-ignored; never commit it.
# README.md ("API keys") explains where to get each one.

# --- Stage 1: script writer (Claude) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional. Default: claude-sonnet-5-5
CLAUDE_MODEL=

# --- Stage 2: voiceover (ElevenLabs) ---
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Voice Library -> pick a voice -> "Copy voice ID"
ELEVENLABS_VOICE_ID=
# Optional. Default set in Stage 2.
ELEVENLABS_MODEL=

# --- Stage 3: Veo clips (Gemini API) ---
# https://aistudio.google.com/apikey  (billing must be enabled; Veo has no free tier)
GEMINI_API_KEY=

# --- Stage 5: approval (Telegram) ---
# Talk to @BotFather -> /newbot -> copy the token
TELEGRAM_BOT_TOKEN=
# Send your bot a message, then open https://api.telegram.org/bot<TOKEN>/getUpdates
# and copy message.chat.id
TELEGRAM_CHAT_ID=

# --- Stage 6: YouTube upload (OAuth) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Desktop app)
# Download the JSON. Both files are git-ignored.
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=youtube_token.json
